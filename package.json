{
  "name": "dsh-selection-quote-plugin",
  "version": "1.2.0",
  "description": "Quote selections into the DeepSeek Harness composer — chat messages, sidebar text/code/Markdown previews, and spreadsheet cell ranges, each with a source label, sheet/range, and absolute file path.",
  "type": "module",
  "license": "MIT",
  "author": "YuzhenZhou1327 <nuchenzhou@qq.com>",
  "homepage": "https://github.com/YuzhenZhou1327/dsh-quote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuzhenZhou1327/dsh-quote.git"
  },
  "bugs": {
    "url": "https://github.com/YuzhenZhou1327/dsh-quote/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "selection",
    "quote",
    "citation",
    "spreadsheet"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
